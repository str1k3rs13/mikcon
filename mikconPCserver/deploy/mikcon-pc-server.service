[Unit]
Description=MikconPC Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mikcon/mikconPCserver
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3
Environment=PORT=8787
# Optional: Environment=MIKCON_DATA=/var/lib/mikcon-pc-server
# Use a Node 22.5+ binary. `node --version` must print v22.5 or newer.

[Install]
WantedBy=multi-user.target
